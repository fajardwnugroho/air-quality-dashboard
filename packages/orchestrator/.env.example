PORT=3001
# SCRIPTS_ROOT=./pipeline

# Metadata DB: Supabase (pipefitter_meta schema) or leave empty for local SQLite
DATABASE_URL=

# Slack failure notification (optional)
SLACK_WEBHOOK_URL=

# Per-pipeline client DB URL — Supabase serving DB (injected as CLIENT_DB_URL
# into the sync_gold stage). Uses a read-only role in production.
CLIENT_DB_URL_OPENAQ_AIR_QUALITY=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres