# ── Orchestrator ──────────────────────────────────────────
PORT=3001
# SCRIPTS_ROOT=./pipeline

# Metadata DB: SQLite (default) or Supabase/Postgres via DATABASE_URL.
# Pipefitter metadata lives in the `pipefitter_meta` schema of the same
# Supabase project that serves Gold data.
# DATABASE_URL=postgresql://postgres:xxx@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Slack failure notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here

# ── OpenAQ API ────────────────────────────────────────────
# Free key: https://explore.openaq.org/register → https://explore.openaq.org/account
OPENAQ_API_KEY=YOUR_OPENAQ_API_KEY
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_CITIES=Jakarta,Bandung,Surabaya,Medan,Denpasar,Yogyakarta,Semarang
OPENAQ_PARAMETERS=pm25,pm10,o3,no2
OPENAQ_COUNTRY=ID

# ── DuckDB warehouse ──────────────────────────────────────
DUCKDB_PATH=./data/air_quality.duckdb
OPENAQ_BACKFILL_DAYS=60

# ── Supabase serving DB (injected into sync stage as CLIENT_DB_URL) ──
# Postgres connection string for the serving schema (Gold mirror).
CLIENT_DB_URL_OPENAQ_AIR_QUALITY=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres